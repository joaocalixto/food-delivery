# Copie para .env (na raiz do food-delivery/) e preencha.
# NUNCA commite o .env — confira que ele esta no .gitignore.

# Organization Settings -> API Keys -> New Key
DD_API_KEY=cole_sua_api_key_aqui

# Precisa bater com o site da sua conta (olhe a URL apos o login):
#   app.datadoghq.com      -> datadoghq.com
#   app.us5.datadoghq.com  -> us5.datadoghq.com
#   app.us3.datadoghq.com  -> us3.datadoghq.com
#   app.datadoghq.eu       -> datadoghq.eu
DD_SITE=datadoghq.com
